{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "ssh",
      "runtimeArgs": [
        "-N",
        "-o", "BatchMode=yes",
        "-o", "ExitOnForwardFailure=yes",
        "-o", "ServerAliveInterval=30",
        "-L", "127.0.0.1:8081:127.0.0.1:3211",
        "nosserver"
      ],
      "port": 8081
    },
    {
      "name": "backend-local",
      "runtimeExecutable": "java",
      "runtimeArgs": [
        "-Xms64m",
        "-Xmx384m",
        "-Xss512k",
        "-XX:+UseSerialGC",
        "-XX:TieredStopAtLevel=1",
        "-XX:ReservedCodeCacheSize=64m",
        "-Duser.timezone=Asia/Ho_Chi_Minh",
        "-jar",
        "backend_api/target/backend_api-0.0.1-SNAPSHOT.jar",
        "--spring.config.import=optional:file:backend_api/.env.local[.properties]"
      ],
      "port": 8081
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "tech-zen-ui"],
      "port": 8080
    }
  ]
}
