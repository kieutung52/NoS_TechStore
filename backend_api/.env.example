# Mẫu biến môi trường cho backend_api.
# Chạy local: copy thành `.env.local` (đã gitignore) rồi điền giá trị thật.
# Trên server: đặt các biến này làm biến môi trường.

SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/techstore
DB_USERNAME=techstore_app
DB_PASSWORD=
DB_POOL_SIZE=10
JPA_DDL_AUTO=update

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# RabbitMQ (đặt RABBITMQ_LISTENER_ENABLED=false nếu không có broker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_CONNECTION_TIMEOUT=5s
RABBITMQ_LISTENER_ENABLED=true

# JWT (HS256, tối thiểu 32 ký tự ngẫu nhiên)
JWT_SIGNER_KEY=

# Lưu ảnh: local (thư mục trên máy chủ) | cloudinary (tạm dừng)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:8080/uploads
MAX_UPLOAD_FILE_SIZE=10MB
MAX_UPLOAD_REQUEST_SIZE=50MB

# Cloudinary (chỉ cần khi STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend)
RESEND_API_KEY=
APP_EMAIL_FROM=TechStore <onboarding@resend.dev>
